rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Team members profile and availability rules
    match /members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // Scheduled meetings collection rules
    match /scheduledMeetings/{meetingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
